# Modelo de secrets.toml — copie este arquivo para ".streamlit/secrets.toml"
# (sem o ".example" no nome) e preencha com seus valores reais.
#
# IMPORTANTE: o arquivo ".streamlit/secrets.toml" (sem .example) NUNCA deve
# ser commitado no Git — ele já está no .gitignore por isso. No Streamlit
# Community Cloud, você não sobe esse arquivo: cola o mesmo conteúdo direto
# nas configurações do app (Settings → Secrets), pelo site do Streamlit.
#
# Rodando local (Cursor/venv) sem preencher nada aqui: o app funciona do
# mesmo jeito, só que sem senha e usando o SQLite local em vez do Postgres
# — ótimo pra simular antes de publicar de verdade.

# Senha de acesso ao app (deixe comentado/ausente para não pedir senha,
# como faz sentido ao simular localmente).
# app_password = "escolha-uma-senha-aqui"

# Connection string do banco Postgres (Supabase). Encontre clicando no
# botão verde "Connect" no topo do dashboard do seu projeto Supabase
# (escolha o modo "Session pooler", formato "URI" — costuma funcionar
# melhor com o Streamlit Community Cloud). Veja o passo a passo com prints
# na seção 8.1 do README.
# [postgres]
# url = "postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
